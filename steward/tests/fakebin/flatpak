#!/usr/bin/env python3
import json, os, sys
f = os.path.join(os.environ["FAKE_STATE"], "flatpaks.json")
s = json.load(open(f)) if os.path.exists(f) else {"org.example.Big": "user"}
a = sys.argv[1:]
if a[0] == "list":
    for k, v in s.items():
        print(f"{k}\t{v}" if any("installation" in x for x in a) else k)
elif a[0] == "uninstall":
    s.pop(a[-1], None); json.dump(s, open(f, "w")); print("Uninstalled", a[-1])
