#!/usr/bin/env python3
# Test double for systemctl. State in $FAKE_STATE/units-{user,system}.json.
import json, os, sys
args = sys.argv[1:]
user = "--user" in args
flags = [a for a in args if a.startswith("-")]
pos = [a for a in args if not a.startswith("-")]
f = os.path.join(os.environ["FAKE_STATE"], f"units-{'user' if user else 'system'}.json")
DEFAULT = {"user": {"tracker-miner-fs-3.service": ["active", "enabled"],
                    "evolution-source-registry.service": ["active", "static"],
                    "broken.service": ["inactive", "disabled"],
                    "pipewire.service": ["active", "enabled"],
                    "org.gnome.Shell@wayland.service": ["active", "static"]},
           "system": {"cups.service": ["active", "enabled"], "bluetooth.service": ["active", "enabled"],
                      "dbus-broker.service": ["active", "enabled"], "firewalld.service": ["active", "enabled"],
                      "NetworkManager.service": ["active", "enabled"]}}
st = json.load(open(f)) if os.path.exists(f) else DEFAULT["user" if user else "system"]
save = lambda: json.dump(st, open(f, "w"))
if not pos:
    pos = ["list-units"]
verb = pos[0]
if verb == "is-system-running":
    print("running"); sys.exit(0)
if verb in ("list-units", "list-unit-files", "--failed"):
    for k, (a, e) in st.items():
        print(f"{k} loaded {a} running" if verb == "list-units" else f"{k} {e} enabled")
    sys.exit(0)
if verb == "show-environment":
    sys.exit(0)
if verb == "show":
    props = [args[i + 1] for i, x in enumerate(args) if x == "-p" and i + 1 < len(args)]
    unit = [p for p in pos[1:] if p not in props][0]
    if unit not in st:
        d = {"Id": unit, "LoadState": "not-found", "ActiveState": "inactive", "UnitFileState": ""}
    else:
        a, e = st[unit]
        d = {"Id": unit, "LoadState": "loaded", "ActiveState": a, "UnitFileState": e}
    for k in (props or d):
        print(d[k] if "--value" in args else f"{k}={d[k]}")
    sys.exit(0)
unit = pos[1] if len(pos) > 1 else ""
if unit not in st:
    print(f"Failed to {verb} {unit}: Unit {unit} not found.", file=sys.stderr); sys.exit(5)
a, e = st[unit]
now = "--now" in flags
if verb == "start" and unit != "broken.service": a = "active"
elif verb == "stop": a = "inactive"
elif verb == "restart": a = "active"
elif verb == "enable":
    e = "enabled"
    if now and unit != "broken.service": a = "active"
elif verb == "disable":
    e = "disabled"
    if now: a = "inactive"
elif verb == "is-active":
    print(a); sys.exit(0 if a == "active" else 3)
elif verb == "is-enabled":
    print(e); sys.exit(0 if e == "enabled" else 1)
st[unit] = [a, e]; save()
